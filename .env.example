# Local environment configuration.
# Copy this file to .env and adjust as needed.
# In production, set environment variables via server or container configuration instead.
APP_ENV=dev
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gazeta_uz
DB_USER=root
DB_PASSWORD=

# Admin panel credentials (/admin).
# Generate a hash with: php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
